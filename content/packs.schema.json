{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packs.schema.json",
  "title": "Dojo Deckbuilder packs and progression",
  "description": "Shape of content/packs.json: collection rules, unlockable Characters and Bosses, booster rules, earn rules, the Clearance Level track and pack membership. scripts/check-packs.mjs validates this shape and the cross-file rules a schema cannot express. Only a small keyword set is used (type, enum, const, required, properties, additionalProperties, items, minItems, uniqueItems, pattern, minimum, maximum, exclusiveMinimum, minLength, $ref) so the checker needs no dependency.",
  "type": "object",
  "required": ["schemaVersion", "status", "rulesVersion", "packsRevision", "description", "unlockEverything", "collection", "unlockables", "boosterRules", "earnRules", "levelTrack", "packs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "status": { "enum": ["proposal", "approved"] },
    "rulesVersion": { "type": "string", "pattern": "^v\\d+\\.\\d+$" },
    "packsRevision": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "unlockEverything": { "type": "boolean", "description": "true makes every collectible card, Character and Boss Profile available to everyone, with no packs and no unlocks. The single switch for forks." },
    "collection": { "$ref": "#/$defs/collection" },
    "unlockables": { "$ref": "#/$defs/unlockables" },
    "boosterRules": { "$ref": "#/$defs/boosterRules" },
    "earnRules": { "$ref": "#/$defs/earnRules" },
    "levelTrack": { "$ref": "#/$defs/levelTrack" },
    "packs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pack" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "deckName": { "type": "string", "minLength": 1 },
    "catalogId": { "type": "string", "pattern": "^DDB-[A-Z]{3}-CORE-\\d{3}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "cardRef": {
      "type": "object",
      "required": ["catalogId", "name"],
      "additionalProperties": false,
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogId" },
        "name": { "type": "string", "minLength": 1, "description": "Must match cards.json; kept for readable diffs when rebalancing." }
      }
    },
    "grants": {
      "description": "Currency id to amount.",
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "collection": {
      "type": "object",
      "required": ["ownership", "collectibleDecks", "alwaysAvailableDecks", "unlockableDecks", "matchPools", "poolModel", "openDojo", "minimumStarterPool"],
      "additionalProperties": false,
      "properties": {
        "ownership": { "enum": ["binary"], "description": "Owning a card means it may appear in your matches. There are no copies and no duplicates." },
        "collectibleDecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/deckName" } },
        "alwaysAvailableDecks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/deckName" } },
        "unlockableDecks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/deckName" }, "description": "Decks whose cards are locked unless listed in unlockables.*.starting or unlocked by a reward." },
        "matchPools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "decks"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "decks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/deckName" } }
            }
          }
        },
        "poolModel": { "enum": ["union-of-seated-collections", "host-collection", "intersection-of-seated-collections"] },
        "openDojo": {
          "type": "object",
          "required": ["available", "rewards", "summary"],
          "additionalProperties": false,
          "properties": {
            "available": { "type": "boolean" },
            "rewards": { "enum": ["none", "merit-only", "full"] },
            "summary": { "type": "string" }
          }
        },
        "minimumStarterPool": {
          "description": "What the cards granted to every profile must contain, so a brand-new collection still plays a full game.",
          "type": "object",
          "required": ["subtypes", "attackZones", "defenseZones"],
          "additionalProperties": false,
          "properties": {
            "subtypes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" } },
            "attackZones": { "type": "array", "uniqueItems": true, "items": { "enum": ["High", "Mid", "Low"] } },
            "defenseZones": { "type": "array", "uniqueItems": true, "items": { "enum": ["High", "Mid", "Low"] } }
          }
        }
      }
    },
    "unlockables": {
      "type": "object",
      "required": ["characters", "bosses"],
      "additionalProperties": false,
      "properties": {
        "characters": {
          "type": "object",
          "required": ["deck", "computerOpponents", "starting"],
          "additionalProperties": false,
          "properties": {
            "deck": { "$ref": "#/$defs/deckName" },
            "computerOpponents": { "enum": ["any", "unlocked"], "description": "Which Characters computer opponents may field." },
            "starting": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cardRef" } }
          }
        },
        "bosses": {
          "type": "object",
          "required": ["deck", "starting"],
          "additionalProperties": false,
          "properties": {
            "deck": { "$ref": "#/$defs/deckName" },
            "starting": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cardRef" } }
          }
        }
      }
    },
    "boosterRules": {
      "type": "object",
      "required": ["cardsPerPack", "contents", "lastPack", "completedBooster", "completedCollection", "randomness"],
      "additionalProperties": false,
      "properties": {
        "cardsPerPack": { "$ref": "#/$defs/positiveInteger" },
        "contents": { "enum": ["new-cards-only"], "description": "A pack only ever contains cards the player does not own yet, drawn at random from the chosen series." },
        "lastPack": { "enum": ["remaining-cards"], "description": "When fewer than cardsPerPack new cards remain in a series, its last pack holds exactly those." },
        "completedBooster": { "enum": ["cannot-be-chosen"] },
        "completedCollection": {
          "type": "object",
          "required": ["ticketConvertsToMerit"],
          "additionalProperties": false,
          "properties": { "ticketConvertsToMerit": { "$ref": "#/$defs/nonNegativeInteger" } }
        },
        "randomness": { "enum": ["seeded-per-profile"] }
      }
    },
    "earnRules": {
      "type": "object",
      "required": ["currencies", "matchResults", "bonuses", "difficultyMeritMultipliers", "modes", "tables", "eligibility"],
      "additionalProperties": false,
      "properties": {
        "currencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "summary"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1 },
              "summary": { "type": "string" },
              "exchangeRate": { "$ref": "#/$defs/positiveInteger" },
              "exchangesFor": { "$ref": "#/$defs/id" }
            }
          }
        },
        "matchResults": {
          "type": "object",
          "required": ["win", "loss"],
          "additionalProperties": false,
          "properties": { "win": { "$ref": "#/$defs/grants" }, "loss": { "$ref": "#/$defs/grants" } }
        },
        "bonuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "when", "grants"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "when": { "enum": ["first-win-local-day", "every-third-consecutive-win", "each-in-match-belt-promotion", "win-against-master-difficulty"] },
              "grants": { "$ref": "#/$defs/grants" }
            }
          }
        },
        "difficultyMeritMultipliers": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mode", "summary"],
            "additionalProperties": false,
            "properties": {
              "mode": { "$ref": "#/$defs/id" },
              "summary": { "type": "string" },
              "extraMeritPerOpponent": { "$ref": "#/$defs/nonNegativeInteger" },
              "stageMeritMultipliers": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
            }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "rewards"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["vs-bots", "online-lockstep", "local-hot-seat", "open-dojo"] },
              "rewards": { "enum": ["none", "merit-only", "full"] }
            }
          }
        },
        "eligibility": {
          "type": "object",
          "required": ["minimumCompletedRounds", "concessionBeforeMinimum", "oneRewardPerMatchId"],
          "additionalProperties": false,
          "properties": {
            "minimumCompletedRounds": { "$ref": "#/$defs/nonNegativeInteger" },
            "concessionBeforeMinimum": { "enum": ["no-reward", "loss-reward"] },
            "oneRewardPerMatchId": { "type": "boolean" }
          }
        }
      }
    },
    "reward": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["booster-ticket", "unlock-booster", "starter-kit-choice", "unlock-character", "unlock-boss", "cosmetic", "title"] },
        "count": { "$ref": "#/$defs/positiveInteger" },
        "pack": { "$ref": "#/$defs/id" },
        "choiceGroup": { "$ref": "#/$defs/id" },
        "catalogId": { "$ref": "#/$defs/catalogId" },
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^[a-z-]+:[a-z0-9-]+$" }
      }
    },
    "levelTrack": {
      "type": "object",
      "required": ["name", "currency", "summary", "diplomas", "levels", "afterFinalLevel"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "currency": { "$ref": "#/$defs/id" },
        "summary": { "type": "string" },
        "diplomas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "belt", "fromLevel"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1 },
              "belt": { "$ref": "#/$defs/id" },
              "fromLevel": { "$ref": "#/$defs/positiveInteger" }
            }
          }
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["level", "meritTotal", "rewards"],
            "additionalProperties": false,
            "properties": {
              "level": { "$ref": "#/$defs/positiveInteger" },
              "meritTotal": { "$ref": "#/$defs/nonNegativeInteger" },
              "rewards": { "type": "array", "items": { "$ref": "#/$defs/reward" } }
            }
          }
        },
        "afterFinalLevel": {
          "type": "object",
          "required": ["meritPerReward", "rewards"],
          "additionalProperties": false,
          "properties": {
            "meritPerReward": { "$ref": "#/$defs/positiveInteger" },
            "rewards": { "type": "array", "items": { "$ref": "#/$defs/reward" } }
          }
        }
      }
    },
    "pack": {
      "type": "object",
      "required": ["id", "kind", "name", "tagline", "description", "themeBuildPaths", "cards"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["starter", "booster"] },
        "grant": { "enum": ["every-profile", "choose-one"], "description": "Starter packs only: granted to every new profile, or chosen from a choice group." },
        "choiceGroup": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "themeBuildPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "completionReward": { "$ref": "#/$defs/reward", "description": "Boosters only: granted once the player owns every card in the series." },
        "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cardRef" } }
      }
    }
  }
}
